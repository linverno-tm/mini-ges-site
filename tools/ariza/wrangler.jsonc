// Lead endpoint for the enquiry form (see README.md). Deploy from this folder: npx wrangler deploy
{
  "name": "mini-ges-ariza",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    // origins allowed to post the form (no trailing slash); add the domain once it is connected
    "ALLOWED_ORIGINS": "https://linverno-tm.github.io,https://mini-ges.charm-bot.workers.dev,https://miniges.uz,https://www.miniges.uz,http://localhost:5173,http://localhost:5174"
  },
  // 5 leads a minute per visitor IP
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
